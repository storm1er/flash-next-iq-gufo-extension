     case core::GgmlType::kIQ4_XS:
       DequantizeIQ4_XS(src, dst, k);
       return true;
+    case core::GgmlType::kQ2_0:
+      DequantizeQ2_0(src, dst, k);
+      return true;
     default:
       return false;
   }
