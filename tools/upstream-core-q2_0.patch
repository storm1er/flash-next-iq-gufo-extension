index a8263aa1..9e112509 100644
--- a/src/core/quant/ggml_dequant.cpp
+++ b/src/core/quant/ggml_dequant.cpp
@@ -231,6 +231,11 @@ std::size_t QuantizedRowBytes(core::GgmlType type,
     case core::GgmlType::kIQ3_S:
       block_bytes = sizeof(block_iq3_s);
       break;
+    case core::GgmlType::kQ2_0:
+      // GGML Q2_0: 64 elements per block — f16 scale + 16 bytes of 2-bit
+      // codes (00=-1, 01=0, 10=+1, 11=+2).
+      block_bytes = 18;
+      break;
     default:
       return 0;
   }
@@ -671,6 +676,21 @@ void DequantizeIQ3_S(const void* src, float* dst, std::size_t k) {
   }
 }
 
+void DequantizeQ2_0(const void* src, float* dst, std::size_t k) {
+  const auto* bytes = static_cast<const std::uint8_t*>(src);
+  const std::size_t nb = k / 64;
+  for (std::size_t b = 0; b < nb; ++b) {
+    std::uint16_t dh = 0;
+    std::memcpy(&dh, bytes + b * 18, sizeof(dh));
+    const float d = Fp16ToFloat(dh);
+    for (std::size_t i = 0; i < 64; ++i) {
+      const std::uint8_t byte = bytes[b * 18 + 2 + i / 4];
+      const std::uint8_t q = (byte >> ((i % 4) * 2)) & 0x3U;
+      dst[b * 64 + i] = static_cast<float>(static_cast<int>(q) - 1) * d;
+    }
+  }
+}
